    "layout": {
      "$ref": "#/$defs/Layout"
    },
    "queries": {
      "default": [],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/SqlQuery"
          },
          {
            "$ref": "#/$defs/KpiQuery"
          },
          {
            "$ref": "#/$defs/ForecastQuery"
          }
        ]
      },
      "maxItems": 20,
      "title": "Queries",
      "type": "array"
    },
    "spec_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Spec Version",
      "type": "integer"
    },
    "subtitle": {
      "anyOf": [
        {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtitle"
    },
    "tiles": {
      "items": {
        "discriminator": {
          "mapping": {
            "area": "#/$defs/AreaTile",
            "bar": "#/$defs/BarTile",
            "line": "#/$defs/LineTile",
            "sparkline": "#/$defs/SparklineTile",
            "stacked_bar": "#/$defs/StackedBarTile",
            "stat": "#/$defs/StatTile",
            "table": "#/$defs/TableTile",
            "text": "#/$defs/TextTile"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/StatTile"
          },
          {
            "$ref": "#/$defs/LineTile"
          },
          {
            "$ref": "#/$defs/AreaTile"
          },
          {
            "$ref": "#/$defs/BarTile"
          },
          {
            "$ref": "#/$defs/StackedBarTile"
          },
          {
            "$ref": "#/$defs/SparklineTile"
          },
          {
            "$ref": "#/$defs/TableTile"
          },
          {
            "$ref": "#/$defs/TextTile"
          }
        ]
      },
      "maxItems": 24,
      "minItems": 1,
      "title": "Tiles",
      "type": "array"
    },
    "title": {
      "maxLength": 200,
