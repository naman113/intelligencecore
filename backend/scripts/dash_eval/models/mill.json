 },
 {
  "object": "relationship",
  "op": "create",
  "definition": {
   "name": "rolls_inward_quality_id_to_qualities",
   "from_relation": "public.rolls_inward",
   "from_columns": [
    "quality_id"
   ],
   "to_relation": "public.qualities",
   "to_columns": [
    "quality_id"
   ],
   "cardinality": "many_to_one",
   "origin": "foreign_key"
  }
 },
 {
  "object": "relationship",
  "op": "create",
  "definition": {
