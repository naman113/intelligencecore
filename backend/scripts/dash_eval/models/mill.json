 },
 {
  "object": "relationship",
  "op": "create",
  "definition": {
   "name": "grns_supplier_id_to_suppliers",
   "from_relation": "public.grns",
   "from_columns": [
    "supplier_id"
   ],
   "to_relation": "public.suppliers",
   "to_columns": [
    "supplier_id"
   ],
   "cardinality": "many_to_one",
   "origin": "foreign_key"
  }
 },
 {
  "object": "relationship",
  "op": "create",
  "definition": {
   "name": "dispatches_customer_id_to_customers",
