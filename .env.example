# Template for LOCAL DEVELOPMENT. Copy to .env (setup.sh does this and fills in
# the generated secrets for you).
#
# On a client VM you do NOT edit this file or .env — install.sh generates the
# secrets and everything else is entered on the dashboard Setup page, which
# stores values in Postgres (system_configs). Precedence: dashboard > .env > default.
#
# Never commit real values here. This file ships to every clone.

# ── LLM keys ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # required for embeddings (text-embedding-3-small)

# ── Business data the agent reads (READ-ONLY) ────────────
# The DB the agent runs SQL against. Use a read-only role — a read-only session
# is forced regardless (guardrails.py), but the role is the outer layer.
TENANT_DATABASE_URL=postgresql://agent_readonly:pass@host:5432/dbname
CAISAAS_DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── Working memory (local, docker-compose) ───────────────
MEMORY_DATABASE_URL=postgresql://agent:agent@localhost:5433/agent_memory

# ── Secrets — GENERATE, never copy a value from anywhere ──
# Both:  openssl rand -hex 32
# OPS_KEY is the admin key for the dashboard and every /api route.
# WEBHOOK_SECRET is shared with the WhatsApp connector ONLY and must never be
# reused as OPS_KEY — that would hand the connector full admin access.
OPS_KEY=
WEBHOOK_SECRET=
# Phase 11: key that encrypts secret settings stored in Postgres. Generate with
# openssl rand -hex 32 (install.sh, setup.sh and deploy/local.ps1 up do it). NEVER change it once
# secrets are saved. Back it up with OPS_KEY, and keep it out of DB backups.
SETTINGS_ENCRYPTION_KEY=

# ── WhatsApp connector ────────────────────────────────────
WA_API_BASE=https://your-connector.example.com
WA_API_KEY=

# Comma-separated phone numbers allowed to talk to the agent (country code, no +)
# Leave empty ONLY on a local dev box: empty means no allowlist is enforced.
ALLOWED_NUMBERS=

# ── Models ────────────────────────────────────────────────
# Model defaults live in backend/app/config.py; the Setup page overrides them.
# SUPERVISOR_MODEL=claude-opus-5-5
# REFLECTION_MODEL=

# ── Warehouse (Phase 14) ──────────────────────────────────
# Generated by setup.sh, install.sh, agentctl update and local.ps1; never overwritten.
WAREHOUSE_ADMIN_PASSWORD=
WH_OWNER_PASSWORD=
WH_LOADER_PASSWORD=
WH_READER_PASSWORD=
# Setting this (for example postgresql://127.0.0.1:5434/warehouse) switches business reads to the warehouse.
WAREHOUSE_URL=

# ── Data sources (Phase 15, optional) ─────────────────────
# Defaults shown. Empty SYNC_NETWORK / SYNC_CSV_NETWORK are discovered from the warehouse container
# (database jobs use the dedicated sync_egress network, which holds only the warehouse; csv jobs the
# internal one). SYNC_NETWORK is an override only (Quick 028): a network you name here is trusted as is.
# SYNC_IMAGE=agentic-sync:latest
# SYNC_NETWORK=
# SYNC_CSV_NETWORK=
# SYNC_WAREHOUSE_HOST=agentic-warehouse   # the warehouse container_name (Quick 031); set it when an overlay renames the container
# SYNC_MEMORY=1g
# SYNC_CPUS=1.0
