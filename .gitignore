.claude/
backend/snapshot.json
_to_delete/
backend/backups/

# Phase 11: agentctl backup output (never commit dumps)
backups/

# Never commit secrets or client data
*.env
!.env.example
*SECRETS*
*.pem
*.key
secrets/
